// chnnl — Enterprise Psychological Safety, Wellbeing & Psychosocial Risk Intelligence Platform
// Domain model. Multi-tenant by Organization; every leaf entity carries organizationId
// so row-level tenant isolation can be enforced consistently at the data-access layer.
//
// IDENTITY ARCHITECTURE (three Postgres schemas in one database, three DB roles):
//   "app"      — pseudonymous tenant data. Person (never PII) is the FK target for every
//                app data table. This is what the app's default Prisma client (chnnl_app
//                role) can read/write. This role has NO grants on "identity".
//   "identity" — PII (name, email, credentials). IdentityRecord has a plain, un-related
//                `personId` column — deliberately NOT a Prisma @relation — so there is no
//                query path, even at the ORM level, from Person back to IdentityRecord.
//                Only src/lib/identity/* may import the identity-scoped Prisma client
//                (chnnl_identity role, DB-granted access to this schema only).
//   "platform" — chnnl's own cross-tenant staff & the break-glass identity-unlock audit
//                trail. Never an organisation-side role. chnnl_platform role only.
// See infra/db/roles.sql for the actual GRANTs, and src/lib/identity, src/lib/platform
// for the two restricted access modules.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  // Runtime query engine (the app's main Prisma client) — the restricted chnnl_app role,
  // "app" schema only.
  url       = env("DATABASE_URL")
  // Migrations only — a role with DDL rights across all three schemas. Never used at
  // runtime. See infra/db/roles.sql and .env.example.
  directUrl = env("MIGRATE_DATABASE_URL")
  schemas   = ["app", "identity", "platform"]
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy, org structure & pseudonymous identity ("app" schema)
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  industry            String?
  logoUrl             String?
  timezone            String   @default("Pacific/Auckland")
  planTier            PlanTier @default(GROWTH)
  ssoDomain           String?
  // Minimum cohort size before a filtered breakdown is displayed; smaller groups are
  // suppressed or rolled up to the next broader grouping. See src/lib/data/k-anonymity.ts.
  kAnonymityThreshold Int      @default(5)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  people                 Person[]
  divisions              Division[]
  departments            Department[]
  teams                  Team[]
  locations              Location[]
  workplaceGroups        WorkplaceGroup[]
  checkIns               CheckIn[]
  who5Results            Who5Result[]
  batResults             BatResult[]
  surveys                Survey[]
  surveyResponses        SurveyResponse[]
  speakUpReports         SpeakUpReport[]
  risks                  PsychosocialRisk[]
  actionPlanItems        ActionPlanItem[]
  riskControls           RiskControl[]
  recommendations        Recommendation[]
  challenges             Challenge[]
  reports                Report[]
  auditLogs              AuditLog[]
  activityEvents         ActivityEvent[]
  learningResources      LearningResource[]
  notifications          Notification[]
  connectorInstallations ConnectorInstallation[]
  apiKeys                ApiKey[]

  @@map("organizations")
  @@schema("app")
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE

  @@schema("app")
}

model Division {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  departments    Department[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("divisions")
  @@schema("app")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  divisionId     String?
  division       Division?    @relation(fields: [divisionId], references: [id])
  name           String
  teams          Team[]
  people         Person[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("departments")
  @@schema("app")
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  name           String
  managerId      String?
  manager        Person?      @relation("TeamManager", fields: [managerId], references: [id])
  members        Person[]     @relation("TeamMembers")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("teams")
  @@schema("app")
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  region         String?
  country        String?
  people         Person[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("locations")
  @@schema("app")
}

model WorkplaceGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  people         Person[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("workplace_groups")
  @@schema("app")
}

// Org-scoped role. Note: even the top org role never spans tenants — cross-tenant
// chnnl staff are a wholly separate concept, see PlatformStaffAccount below.
enum PlatformRole {
  ORG_OWNER
  ORG_ADMIN
  EXECUTIVE
  PEOPLE_AND_CULTURE
  HEALTH_AND_SAFETY
  DEPARTMENT_MANAGER
  LEADER
  EMPLOYEE

  @@schema("app")
}

enum SeniorityLevel {
  EXECUTIVE
  SENIOR_LEADER
  MANAGER
  TEAM_LEAD
  INDIVIDUAL_CONTRIBUTOR

  @@schema("app")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
  FIXED_TERM
  CONTRACTOR

  @@schema("app")
}

/// The pseudonymous "user code" entity. Every piece of app data is written against
/// Person.id, never against a name/email. Deliberately holds NO PII — see IdentityRecord
/// in the "identity" schema, which has no Prisma relation back to this model.
model Person {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role           PlatformRole    @default(EMPLOYEE)
  roleType       String?
  seniority      SeniorityLevel?
  employmentType EmploymentType?

  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id])
  locationId       String?
  location         Location?       @relation(fields: [locationId], references: [id])
  workplaceGroupId String?
  workplaceGroup   WorkplaceGroup? @relation(fields: [workplaceGroupId], references: [id])

  managedTeams Team[] @relation("TeamManager")
  teams        Team[] @relation("TeamMembers")

  mfaEnabled  Boolean      @default(false)
  lastLoginAt DateTime?
  status      PersonStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns            CheckIn[]
  who5Results         Who5Result[]
  batResults          BatResult[]
  surveyResponses     SurveyResponse[]
  speakUpReportsOwned SpeakUpReport[]        @relation("ReportOwnerInternal")
  riskOwnerOf         PsychosocialRisk[]     @relation("RiskOwner")
  actionsOwned        ActionPlanItem[]       @relation("ActionOwner")
  challengeEntries    ChallengeParticipant[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  sessions            Session[]
  accounts            Account[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("people")
  @@schema("app")
}

enum PersonStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED

  @@schema("app")
}

// Auth.js required models — reference Person (pseudonymous) only.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              Person  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
  @@schema("app")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         Person   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
  @@schema("app")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Wellbeing domains (shared taxonomy used across check-ins, surveys, risks)
// ─────────────────────────────────────────────────────────────────────────

enum WellbeingDomain {
  WORK_DESIGN
  CULTURE_AND_LEADERSHIP
  SOCIAL_CONNECTIONS
  MANA_WHENUA
  DEI
  PERSONAL_FACTORS
  PSYCHOLOGICAL_SAFETY
  PSYCHOSOCIAL_RISK
  BURNOUT_BAT
  WHO5
  TE_WHARE_TAPA_WHA

  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Measurement: daily check-ins, WHO-5, BAT burnout, surveys
// ─────────────────────────────────────────────────────────────────────────

model CheckIn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           Person       @relation(fields: [userId], references: [id], onDelete: Cascade)

  moodScore     Int // 1-5
  energyScore   Int // 1-5
  stressScore   Int // 1-5
  workloadScore Int? // 1-5
  reflection    String?         @db.Text
  domain        WellbeingDomain @default(PERSONAL_FACTORS)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("check_ins")
  @@schema("app")
}

model Who5Result {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           Person       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Raw item scores, 0-5 each, per WHO-5 instrument
  q1Cheerful    Int
  q2Calm        Int
  q3Active      Int
  q4RestedFresh Int
  q5Interesting Int

  rawScore        Int // sum 0-25
  percentageScore Int // rawScore * 4, 0-100
  belowThreshold  Boolean // true if percentageScore <= 50 (screening flag)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("who5_results")
  @@schema("app")
}

model BatResult {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           Person       @relation(fields: [userId], references: [id], onDelete: Cascade)

  exhaustionScore          Float
  mentalDistanceScore      Float
  cognitiveImpairmentScore Float
  emotionalImpairmentScore Float
  coreBurnoutScore         Float // mean of exhaustion + mental distance
  secondaryScore           Float // mean of cognitive + emotional impairment
  overallScore             Float
  riskBand                 BurnoutRiskBand

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("bat_results")
  @@schema("app")
}

enum BurnoutRiskBand {
  LOW
  MODERATE
  HIGH
  CRITICAL

  @@schema("app")
}

model Survey {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?          @db.Text
  domain         WellbeingDomain
  status         SurveyStatus     @default(DRAFT)
  questions      SurveyQuestion[]
  responses      SurveyResponse[]
  opensAt        DateTime?
  closesAt       DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@map("surveys")
  @@schema("app")
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED

  @@schema("app")
}

model SurveyQuestion {
  id       String          @id @default(cuid())
  surveyId String
  survey   Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  prompt   String
  type     QuestionType    @default(LIKERT_5)
  domain   WellbeingDomain
  order    Int             @default(0)
  answers  SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_questions")
  @@schema("app")
}

enum QuestionType {
  LIKERT_5
  LIKERT_7
  YES_NO
  FREE_TEXT
  MULTIPLE_CHOICE

  @@schema("app")
}

model SurveyResponse {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  surveyId       String
  survey         Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId         String? // nullable to support anonymous survey modes
  user           Person?        @relation(fields: [userId], references: [id])
  answers        SurveyAnswer[]
  submittedAt    DateTime       @default(now())

  @@index([organizationId])
  @@index([surveyId])
  @@map("survey_responses")
  @@schema("app")
}

model SurveyAnswer {
  id           String         @id @default(cuid())
  responseId   String
  response     SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId   String
  question     SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  numericValue Int?
  textValue    String?        @db.Text

  @@index([responseId])
  @@map("survey_answers")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Psychosocial risk intelligence & risk management
// ─────────────────────────────────────────────────────────────────────────

enum RiskCategory {
  WORK_DEMANDS
  ROLE_CLARITY
  LEADERSHIP
  RECOGNITION
  WORK_RELATIONSHIPS
  BULLYING
  HARASSMENT
  CHANGE_MANAGEMENT
  JOB_CONTROL
  SUPPORT
  INCLUSION
  PSYCHOLOGICAL_SAFETY
  FATIGUE
  BURNOUT
  ISOLATION
  ORGANISATIONAL_JUSTICE

  @@schema("app")
}

enum RiskTrend {
  IMPROVING
  STABLE
  WORSENING

  @@schema("app")
}

enum RiskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("app")
}

enum RiskStatus {
  IDENTIFIED
  MONITORING
  ACTION_PLANNED
  IN_PROGRESS
  RESOLVED

  @@schema("app")
}

model PsychosocialRisk {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category            RiskCategory
  domain              WellbeingDomain?
  title               String
  summary             String           @db.Text
  whyItMatters        String           @db.Text
  worksafeContext     String?          @db.Text // plain-English framing only — never legal advice, see src/lib/labels.ts guard copy
  contributingFactors String[]         @default([])

  // Risk Journey — the *current* snapshot of each state for cheap dashboard reads.
  // Full history (including intermediate movements) lives in RiskStateChange below.
  inherentScore Float? // risk level before any controls existed
  currentScore  Float // 0-100, higher = more risk — today's level
  residualScore Float? // projected/actual level once planned controls are in place
  targetScore   Float? // organisation's desired level

  trend      RiskTrend    @default(STABLE)
  likelihood Int // 1-5
  impact     Int // 1-5
  priority   RiskPriority
  confidence Int // 0-100

  status  RiskStatus @default(IDENTIFIED)
  ownerId String?
  owner   Person?    @relation("RiskOwner", fields: [ownerId], references: [id])

  departmentScope String? // optional department name/id filter context
  locationScope   String?
  evidenceSummary String?   @db.Text
  nextReviewDate  DateTime?

  recommendations Recommendation[]
  actionPlanItems ActionPlanItem[]
  controls        RiskControl[]
  history         RiskHistoryPoint[]
  stateChanges    RiskStateChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@map("psychosocial_risks")
  @@schema("app")
}

/// Legacy simple score-over-time log (kept for the existing trend chart). New work should
/// use RiskStateChange, which distinguishes inherent/current/residual/target explicitly.
model RiskHistoryPoint {
  id         String           @id @default(cuid())
  riskId     String
  risk       PsychosocialRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  score      Float
  recordedAt DateTime         @default(now())

  @@index([riskId, recordedAt])
  @@map("risk_history_points")
  @@schema("app")
}

enum RiskStateType {
  INHERENT
  CURRENT
  RESIDUAL
  TARGET

  @@schema("app")
}

enum RiskEvidenceType {
  SURVEY_RESULT
  CHECK_IN_TREND
  SPEAK_UP_TREND
  ACTION_COMPLETED
  WORKSHOP_ATTENDANCE
  MANUAL_ASSESSMENT

  @@schema("app")
}

/// Append-only log — the Risk Journey. Every state transition is a new row, never an
/// update, so the full inherent → current → residual → target movement is always
/// reconstructable, each entry linked to the evidence that justified it.
model RiskStateChange {
  id           String            @id @default(cuid())
  riskId       String
  risk         PsychosocialRisk  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  stateType    RiskStateType
  score        Float
  note         String?           @db.Text
  evidenceType RiskEvidenceType?
  evidenceRef  String? // free-form pointer to the supporting record (survey id, action id, etc.)
  recordedById String? // Person.id of the leader who logged this, if manually recorded
  recordedAt   DateTime          @default(now())

  @@index([riskId, stateType, recordedAt])
  @@map("risk_state_changes")
  @@schema("app")
}

enum ControlEffectiveness {
  NOT_YET_ASSESSED
  LOW
  MEDIUM
  HIGH

  @@schema("app")
}

enum ControlStatus {
  PLANNED
  ACTIVE
  RETIRED

  @@schema("app")
}

model RiskControl {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  riskId         String
  risk           PsychosocialRisk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  description    String
  effectiveness  ControlEffectiveness @default(NOT_YET_ASSESSED)
  status         ControlStatus        @default(ACTIVE)
  createdAt      DateTime             @default(now())

  @@index([organizationId])
  @@index([riskId])
  @@map("risk_controls")
  @@schema("app")
}

enum ActionPlanStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  OVERDUE

  @@schema("app")
}

/// The structured Action Plan entity referenced by both the risk detail page and the
/// Compliance Dashboard / Dynamic Risk Register "Next Action" column.
model ActionPlanItem {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  riskId           String
  risk             PsychosocialRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   Recommendation?  @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  title             String
  description       String           @db.Text
  ownerId           String?
  owner             Person?          @relation("ActionOwner", fields: [ownerId], references: [id])
  dueDate           DateTime?
  priority          RiskPriority     @default(MEDIUM)
  status            ActionPlanStatus @default(NOT_STARTED)
  expectedOutcome   String?          @db.Text
  progressNotes     String?          @db.Text
  progressPercent   Int              @default(0)
  evidenceUrls      String[]         @default([])
  reviewDate        DateTime?
  residualRiskScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([riskId])
  @@index([status, dueDate])
  @@map("action_plan_items")
  @@schema("app")
}

enum RecommendationType {
  LEADERSHIP_ACTION
  POLICY
  COMMUNICATION
  MANAGER_COACHING
  TEAM_INTERVENTION
  WORK_REDESIGN
  ROLE_CLARIFICATION
  RECOGNITION
  FLEXIBLE_WORK
  PROCESS_IMPROVEMENT
  PSYCH_SAFETY_INITIATIVE
  WORKSHOP
  LEARNING_RESOURCE

  @@schema("app")
}

model Recommendation {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  riskId         String?
  risk           PsychosocialRisk? @relation(fields: [riskId], references: [id], onDelete: SetNull)

  type           RecommendationType
  title          String
  description    String               @db.Text
  expectedImpact String?
  effortLevel    EffortLevel          @default(MEDIUM)
  status         RecommendationStatus @default(SUGGESTED)

  actionPlanItems ActionPlanItem[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("recommendations")
  @@schema("app")
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH

  @@schema("app")
}

enum RecommendationStatus {
  SUGGESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DISMISSED

  @@schema("app")
}

model LearningResource {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title                 String
  type                  LearningResourceType
  domain                WellbeingDomain
  relatedRiskCategories RiskCategory[]       @default([])
  summary               String               @db.Text
  url                   String?
  durationMinutes       Int?

  createdAt DateTime @default(now())

  @@map("learning_resources")
  @@schema("app")
}

enum LearningResourceType {
  ARTICLE
  RESEARCH_SUMMARY
  VIDEO
  GUIDE
  TEMPLATE
  TOOLKIT
  WORKSHOP

  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Speak Up (anonymous reporting)
// ─────────────────────────────────────────────────────────────────────────

enum SpeakUpCategory {
  BULLYING
  HARASSMENT
  UNSAFE_BEHAVIOUR
  PSYCHOLOGICAL_SAFETY
  WORKPLACE_ISSUE
  ETHICAL_CONCERN
  GENERAL_WELLBEING

  @@schema("app")
}

enum SpeakUpStatus {
  SUBMITTED
  UNDER_REVIEW
  INVESTIGATING
  ACTION_TAKEN
  RESOLVED
  CLOSED

  @@schema("app")
}

model SpeakUpReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Anonymous tracking code shown to the submitter; never linked to identity in leader views
  trackingCode  String          @unique
  category      SpeakUpCategory
  description   String          @db.Text
  isAnonymous   Boolean         @default(true)
  // Only set when the submitter opts in to identify themselves. Even then this is a Person
  // (pseudonymous) reference — leader case views never resolve it to a name (see Part C).
  submittedById String?
  submittedBy   Person?         @relation("ReportOwnerInternal", fields: [submittedById], references: [id])

  departmentScope String?
  locationScope   String?

  status       SpeakUpStatus    @default(SUBMITTED)
  evidenceUrls String[]         @default([])
  messages     SpeakUpMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@map("speak_up_reports")
  @@schema("app")
}

model SpeakUpMessage {
  id         String        @id @default(cuid())
  reportId   String
  report     SpeakUpReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromLeader Boolean       @default(false)
  body       String        @db.Text
  createdAt  DateTime      @default(now())

  @@index([reportId])
  @@map("speak_up_messages")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Team Challenges
// ─────────────────────────────────────────────────────────────────────────

enum ChallengeType {
  STEPS
  HYDRATION
  MINDFULNESS
  WALKING
  GRATITUDE
  LEARNING
  CONNECTION
  SLEEP
  MOVEMENT
  HEALTHY_HABITS

  @@schema("app")
}

model Challenge {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           ChallengeType
  description    String?                @db.Text
  startsAt       DateTime
  endsAt         DateTime
  participants   ChallengeParticipant[]
  createdAt      DateTime               @default(now())

  @@index([organizationId])
  @@map("challenges")
  @@schema("app")
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        Person    @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int       @default(0)
  streak      Int       @default(0)
  badges      String[]  @default([])
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
  @@map("challenge_participants")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Reporting engine
// ─────────────────────────────────────────────────────────────────────────

enum ReportType {
  EXECUTIVE_SUMMARY
  ORGANISATION_HEALTH
  PSYCHOSOCIAL_RISK
  PSYCHOLOGICAL_SAFETY
  BOARD_REPORT
  CUSTOM

  @@schema("app")
}

enum ReportStatus {
  GENERATING
  READY
  FAILED

  @@schema("app")
}

model Report {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ReportType
  title          String
  filters        Json?
  status         ReportStatus @default(GENERATING)
  pdfUrl         String?
  generatedById  String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("reports")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Live activity feed (de-identified) & notifications
// ─────────────────────────────────────────────────────────────────────────

enum ActivityEventType {
  CHECKIN_SUBMITTED
  PARTICIPATION_MILESTONE
  RISK_EMERGING
  RISK_IMPROVING
  SPEAK_UP_SUBMITTED
  BURNOUT_CHANGE
  CHALLENGE_ACTIVITY
  ORG_CHANGE

  @@schema("app")
}

model ActivityEvent {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            ActivityEventType
  message         String
  departmentScope String?
  locationScope   String?
  severity        EventSeverity     @default(INFO)
  createdAt       DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@map("activity_events")
  @@schema("app")
}

enum EventSeverity {
  INFO
  POSITIVE
  WARNING
  CRITICAL

  @@schema("app")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           Person       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt])
  @@map("notifications")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit logging
// ─────────────────────────────────────────────────────────────────────────

enum AuditActorType {
  TENANT_USER
  PLATFORM_STAFF
  SYSTEM

  @@schema("app")
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorType      AuditActorType @default(TENANT_USER)
  userId         String?
  user           Person?        @relation(fields: [userId], references: [id])
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  ipAddress      String?
