# Database — three connection strings, one per Postgres role, enforcing identity isolation
# at the database level (see infra/db/roles.sql). All three point at the same database;
# only the role (and therefore schema access) differs.
#
# DATABASE_URL          — chnnl_app: the main Next.js app. "app" schema only (pseudonymous
#                          tenant data). No access to "identity" or "platform".
# IDENTITY_DATABASE_URL — chnnl_identity: used only by src/lib/identity/*. "identity" schema
#                          only (PII: name, email, credentials).
# PLATFORM_DATABASE_URL — chnnl_platform: used only by src/lib/platform/*. Full access to
#                          "platform" (platform staff, break-glass audit trail), read-only
#                          to "app" (cross-tenant org health) and "identity" (only ever
#                          queried at the moment of an approved break-glass unlock).
#
# Run `psql -f infra/db/roles.sql` against your database once, after the first
# `prisma migrate deploy`, to create these roles.
DATABASE_URL="postgresql://chnnl_app:chnnl_app_dev_password@localhost:5432/chnnl"
IDENTITY_DATABASE_URL="postgresql://chnnl_identity:chnnl_identity_dev_password@localhost:5432/chnnl"
PLATFORM_DATABASE_URL="postgresql://chnnl_platform:chnnl_platform_dev_password@localhost:5432/chnnl"

# Used only to run `prisma migrate`/`db:seed` (needs DDL rights across all three schemas —
# migrations must NOT run as chnnl_app/chnnl_identity/chnnl_platform, which are deliberately
# too restricted to create tables). Not used by the running app.
MIGRATE_DATABASE_URL="postgresql://chnnl:chnnl@localhost:5432/chnnl"

# Redis (caching, rate limiting, pub/sub for realtime fan-out)
REDIS_URL="redis://localhost:6379"

# Auth.js (tenant sign-in)
AUTH_SECRET="replace-with-openssl-rand--base64-32"
AUTH_URL="http://localhost:3000"

# Platform staff session signing (separate from AUTH_SECRET on purpose — a leaked tenant
# secret should never be usable to forge a cross-tenant staff session, or vice versa).
# Falls back to AUTH_SECRET if unset; set a distinct value in any shared environment.
PLATFORM_AUTH_SECRET="replace-with-a-different-openssl-rand--base64-32"

# Symmetric key used to encrypt connector OAuth tokens/API keys at rest
# (src/lib/connectors/crypto.ts). openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY="replace-with-openssl-rand--base64-32"

# Object storage (S3-compatible) for Speak Up evidence uploads & report PDFs
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="chnnl-uploads"

# AI provider (used by AI Insights service — org summaries, risk narratives, recommendations)
ANTHROPIC_API_KEY=""

# Microsoft 365 connector (Entra ID SSO/provisioning, Teams, Outlook) — an Azure AD app
# registration. Without these, the connector is listed in the marketplace but "Connect"
# fails with a clear "not configured" error rather than a confusing one.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Feature flags
ENABLE_MFA="true"
