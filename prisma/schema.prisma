  @@index([organizationId, createdAt])
  @@map("audit_logs")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform integrations & connector framework ("app" schema — per-tenant config)
// ─────────────────────────────────────────────────────────────────────────

enum ConnectorCategory {
  IDENTITY_SSO
  CALENDAR_EMAIL
  HRIS
  PAYROLL
  LMS
  COLLABORATION
  HEALTH_SAFETY
  BUSINESS_INTELLIGENCE
  PROJECT_MANAGEMENT
  AI_PRODUCTIVITY
  WORKFLOW_AUTOMATION

  @@schema("app")
}

enum ConnectorProvider {
  MICROSOFT_365
  GOOGLE_WORKSPACE
  EMPLOYMENT_HERO
  BAMBOOHR
  HIBOB
  WORKDAY
  SAP_SUCCESSFACTORS
  UKG
  DAYFORCE
  ADP
  MOODLE
  CORNERSTONE
  DOCEBO
  SLACK
  MS_TEAMS
  GOOGLE_CHAT
  HEALTH_SAFETY_PLATFORM
  POWER_BI
  TABLEAU
  LOOKER
  MICROSOFT_PLANNER
  JIRA
  ASANA
  MONDAY
  TRELLO
  MICROSOFT_COPILOT
  CHATGPT_ENTERPRISE
  CLAUDE_ENTERPRISE
  GEMINI
  POWER_AUTOMATE
  ZAPIER
  MAKE

  @@schema("app")
}

enum ConnectorSyncMode {
  REALTIME
  SCHEDULED
  MANUAL

  @@schema("app")
}

enum ConnectorStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  ERROR
  DISABLED

  @@schema("app")
}

enum ConnectorSyncStatus {
  SUCCESS
  PARTIAL
  FAILED

  @@schema("app")
}

enum ConnectorSyncTrigger {
  REALTIME_EVENT
  SCHEDULED
  MANUAL
  WEBHOOK

  @@schema("app")
}

/// One row per organisation per connector they've installed. Credentials are encrypted
/// at rest (src/lib/connectors/crypto.ts) — never stored in plaintext, and never logged.
model ConnectorInstallation {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       ConnectorProvider
  category       ConnectorCategory
  status         ConnectorStatus   @default(NOT_CONNECTED)
  syncMode       ConnectorSyncMode @default(MANUAL)

  encryptedCredentials String? @db.Text
  config               Json?

  connectedById    String?
  connectedAt      DateTime?
  lastSyncAt       DateTime?
  lastSyncStatus   ConnectorSyncStatus?
  lastErrorMessage String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncRuns      ConnectorSyncRun[]
  webhookEvents ConnectorWebhookEvent[]

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("connector_installations")
  @@schema("app")
}

model ConnectorSyncRun {
  id               String                @id @default(cuid())
  installationId   String
  installation     ConnectorInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  trigger          ConnectorSyncTrigger
  status           ConnectorSyncStatus
  recordsProcessed Int                   @default(0)
  recordsFailed    Int                   @default(0)
  errorMessage     String?               @db.Text
  startedAt        DateTime              @default(now())
  completedAt      DateTime?

  @@index([installationId, startedAt])
  @@map("connector_sync_runs")
  @@schema("app")
}

model ConnectorWebhookEvent {
  id              String                @id @default(cuid())
  installationId  String
  installation    ConnectorInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  eventType       String
  payload         Json
  processed       Boolean               @default(false)
  processingError String?               @db.Text
  receivedAt      DateTime              @default(now())
  processedAt     DateTime?

  @@index([installationId, receivedAt])
  @@map("connector_webhook_events")
  @@schema("app")
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  hashedKey      String       @unique
  keyPrefix      String
  scopes         String[]     @default([])
  createdById    String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("api_keys")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity store ("identity" schema) — PII only. No Prisma relation to Person
// on purpose: this is the structural enforcement that no query starting from
// tenant/app data can ever traverse into PII. Only src/lib/identity/* touches this.
// ─────────────────────────────────────────────────────────────────────────

model IdentityRecord {
  id             String    @id @default(cuid())
  /// References app.Person.id — intentionally not a Prisma relation field.
  personId       String    @unique
  email          String    @unique
  name           String
  avatarUrl      String?
  passwordHash   String?
  mfaSecret      String?
  hrisEmployeeId String?
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("identity_records")
  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform staff & break-glass identity unlock ("platform" schema) — chnnl-internal,
// cross-tenant. Never an organisation-side role, however senior. See src/lib/platform/*.
// ─────────────────────────────────────────────────────────────────────────

enum PlatformStaffRole {
  SUPER_ADMIN
  SUPPORT
  SAFETY_OFFICER

  @@schema("platform")
}

enum PlatformStaffStatus {
  ACTIVE
  SUSPENDED

  @@schema("platform")
}

model PlatformStaffAccount {
  id           String              @id @default(cuid())
  email        String              @unique
  name         String
  passwordHash String
  role         PlatformStaffRole   @default(SUPPORT)
  status       PlatformStaffStatus @default(ACTIVE)
  mfaEnabled   Boolean             @default(false)
  mfaSecret    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  requestedUnlocks BreakGlassUnlock[] @relation("RequestedBy")
  approvedUnlocks  BreakGlassUnlock[] @relation("ApprovedBy")

  @@map("platform_staff_accounts")
  @@schema("platform")
}

enum BreakGlassStatus {
  PENDING_APPROVAL
  APPROVED
  DENIED
  ACTIVE
  EXPIRED
  REVOKED

  @@schema("platform")
}

/// The safety "break glass" identity re-identification workflow. Two-person rule:
/// requestedBy and approvedBy must always be different staff members. Time-boxed —
/// `expiresAt` bounds how long the unlock stays ACTIVE once approved.
model BreakGlassUnlock {
  id             String @id @default(cuid())
  /// References app.Person.id and its organizationId — deliberately not Prisma relations,
  /// same reasoning as IdentityRecord: this table lives outside any single tenant.
  personId       String
  organizationId String
  reason         String @db.Text

  requestedById String
  requestedBy   PlatformStaffAccount  @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    PlatformStaffAccount? @relation("ApprovedBy", fields: [approvedById], references: [id])
  decidedAt     DateTime?
  denialReason  String?               @db.Text

  status     BreakGlassStatus @default(PENDING_APPROVAL)
  accessedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId])
  @@index([status])
  @@map("break_glass_unlocks")
  @@schema("platform")
}
