# Database
DATABASE_URL="postgresql://chnnl:chnnl@localhost:5432/chnnl?schema=public"

# Redis (caching, rate limiting, pub/sub for realtime fan-out)
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand--base64-32"
AUTH_URL="http://localhost:3000"

# Object storage (S3-compatible) for Speak Up evidence uploads & report PDFs
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="chnnl-uploads"

# AI provider (used by AI Insights service — org summaries, risk narratives, recommendations)
ANTHROPIC_API_KEY=""

# Feature flags
ENABLE_MFA="true"
